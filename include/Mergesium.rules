
.PHONY: me-check

.MAKE: me-check

me-check: check-am $(BUILT_SOURCES)
	@list='$(RECHECK_LOGS)';           test -z "$$list" || rm -f $$list
	@set +e; $(am__set_TESTS_bases); \
	log_list=`for i in $$bases; do echo $$i.log; done`; \
	log_list=`echo $$log_list`; \
	$(MAKE) $(AM_MAKEFLAGS) $$log_list; \
	exit $$?;
