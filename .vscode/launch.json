// A launch configuration that compiles the extension and then opens it inside a new window
{
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Make curl dry",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/make/make",
            "args": [
                    "-j1",
                    "--dry-run",
                    "--print-data-base",
                    "V=1"
            ],
            "stopAtEntry": false,
            "cwd": "/home/radu/proj/curl/build/Mergesium-Debug/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Make coreutils dry",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/make/make",
            "args": [
                    "-j1",
                    "--output-sync=none",
                    "--dry-run",
                    "--print-data-base",
                    "V=1"
            ],
            "stopAtEntry": false,
            "cwd": "/tmp/coreutils/build/Default/gnulib-tests",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Make Mergesium.rules empty me-check-recursive rule",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/make/make",
            "args": [
                    "V=1",
                    "-C", "/home/radu/proj/lasso/build/Xenial",
                    "-Resi",
                    "me-check",
                    "LOG_DRIVER=/home/radu/.vscode-server/extensions/autotools/bin/test-driver",
                    "LOG_DRIVER_FLAGS=--env-name legacy",
                    "--print-directory",
                    "-I", "/home/radu/.vscode-server/extensions/autotools/include",
                    "--eval", "include Mergesium.rules",
                    "am__extra_recursive_targets=ne-check-recursive",
                    "-db",
                    "--trace"
            ],
            "stopAtEntry": false,
            "cwd": "/home/radu/proj/lasso/build/Xenial",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Make lasso incremental tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/make/make",
            "args": [
                    "-j1",
                    "-r",
                    "--trace",
                    "--dry-run",
                    "--silent",
                    "--assume-new=tests.c",
                    "test-suite.log"
            ],
            "stopAtEntry": true,
            "cwd": "/home/radu/proj/lasso/build/Default/tests",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Launch Tests",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "${workspaceFolder}/src/test/fakeSuite/Repros",
                "--disable-workspace-trust",
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--extensionTestsPath=${workspaceFolder}/out/src/test/fakeSuite/index"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/out/src/test/**/*.js"
            ],
            "env": {
                "MAKEFILE_TOOLS_TESTING": "1",
                "WindowsSDKVersion": "12.3.45678.9\\"
            },
            "preLaunchTask": "compile",
        },
        {
            "name": "Launch Extension with --new-window",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [

                "--extensionDevelopmentPath=${workspaceFolder}",
                "--new-window",

            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "compile",
        },
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [

                "--extensionDevelopmentPath=${workspaceFolder}",

            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "compile",
        },
        {
            "name": "Launch Extension (disable others)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}",
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "compile",
        },
        {
            "name": "Node Attach",
            "type": "node",
            "request": "attach",
            "port": 5858
        }
    ]
}