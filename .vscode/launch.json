            "args": [
                    "-j1",
                    "--dry-run",
                    "--print-data-base",
                    "V=1"
            ],
            "stopAtEntry": false,
            "cwd": "/home/radu/proj/curl/build/Mergesium-Debug/src",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
