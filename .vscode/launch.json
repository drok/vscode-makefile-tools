// A launch configuration that compiles the extension and then opens it inside a new window
{
    "version": "0.1.0",
    "configurations": [
        {
            "name": "Make bitcoin src segv",
            "type": "cppdbg",
            "request": "launch",
            "program": "/tmp/make20",
            "args": [
                    "-C", "src", "all",
                    "-j1", "--output-sync=none", "--print-directory",
                    "--print-data-base",
                    "V=1",
                    "--trace",
                    "--dry-run",
                    "--keep-going",
                    "GMOFILES=",
                    "--always-make",
            ],
            "stopAtEntry": false,
            "cwd": "/tmp/bitcoin/build/Debug",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Make debug tesseract continue on errors",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/make/make",
            "args": [
                    "-j1", "--output-sync=none", "--print-directory",
                    "-Res",
                    "me-check",
                    "ME_KEEP_ENV=10qqdhdvoqz",
                    "--eval=include Mergesium.rules",
                    "--trace",
                    "TEST_LOGS=bitvector_test.log",
                    "-db",
                    "-R"
            ],
            "stopAtEntry": false,
            "cwd": "${env:HOME}/proj/tesseract/build/Default",
            "environment": [
                { "name": "MAKEFLAGS",  "value": "-I ${env:HOME}/.vscode-server/extensions/autotools/include" },
                { "name": "LOG_DRIVER", "value": "${env:HOME}//.vscode-server/extensions/autotools/bin/test-driver"},
                { "name": "LOG_DRIVER_FLAGS", "value": "--env-name \"<null>\" --env-id \"10qqdhdvoqz\" --env-keep \"$$ME_KEEP_ENV\""},
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Make debug | tmp in deps @L900",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/make/make",
            "args": [
                    "-j1", "--output-sync=none", "--print-directory",
                    "all", "check",
                    "--print-data-base",
                    "V=1",
                    "--trace",
                    "--dry-run",
                    "--assume-old=\\$(top_srcdir)/configure",
                    "--assume-old=\\$(top_builddir)/config.status",
                    "--keep-going",
                    "GMOFILES=",
                    "--always-make"
            ],
            "stopAtEntry": false,
            "cwd": "${env:HOME}/proj/tesseract/build/Default",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Make curl dry",
