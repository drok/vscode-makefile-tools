            "args": [
                    "-j1",
                    "--output-sync=none",
                    "--dry-run",
                    "--print-data-base",
                    "V=1"
            ],
            "stopAtEntry": false,
            "cwd": "/tmp/coreutils/build/Default/gnulib-tests",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
