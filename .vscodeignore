# Files/Folders to ignore when packaging the extension

# ignore vscode settings for extension development
.vscode/**

# ignore GitHub actions
.github/**

# ignore source files
src/**
out/src/test/**

# ignore development files
.gitignore
.vscodeignore
tsconfig.json
tslint.json
*.log
*.vsix
translations_auto_pr.js
gulpfile.js
vscode-extensions-localization-export/
vscode-translations-import/
i18n/
jobs/
build/
docs/
scripts/
vendor/

# esbundler means these should not be packaged
out/main.js.map
node_modules/
# out/src should be commented in the main branch, so out/src/etension.js is found
# but uncommented in pre/ or rel/ branches so out/src is not included
# out/src
.git
.gitmodules
# package.nls.*.json

# things to be ignored when vsce packages:
share/
include/gnumake.h
admin/
out/admin/
out/buildinfo.*
buildinfo.*
*.code-workspace
