{
    "name": "autotools",
    "displayName": "Autotools Integration",
    "description": "Import autotools configuration into C/C++ IntelliSense",
    "version": "0.1.0",
    "publisher": "mergesium",
    "preview": true,
    "icon": "res/autotools.png",
    "readme": "README.md",
    "author": {
        "name": "Mergesium Inc."
    },
    "license": "SEE LICENSE IN LICENSE.txt",
    "engines": {
        "vscode": "^1.74.0"
    },
    "extensionKind": ["workspace"],
    "bugs": {
        "url": "https://github.com/Mergesium/autotools/issues",
        "email": "autotools-support@mergesium.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mergesium/autotools"
    },
    "homepage": "https://autotools.mergesium.com",
    "qna": "https://github.com/Mergesium/autotools/discussions/categories/q-a",
    "keywords": [
        "C",
        "C++",
        "IntelliSense",
        "Mergesium",
        "Makefile"
    ],
    "categories": [
        "Programming Languages",
        "Debuggers",
        "Testing",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "autotools.addAutotools",
                "title": "%autotools.command.addAutotools.title%"
            },
            {
                "command": "autotools.command.bootstrap",
                "title": "%autotools.command.bootstrap.title%"
            },
            {
                "command": "autotools.buildAll",
                "icon": "$(combine)",
                "title": "%autotools.command.makefile.buildAll.title%"

            },
            {
                "command": "autotools.outline.buildAll",
                "icon": "$(combine)",
                "title": "%autotools.buildAll.title%"

            },
            {
                "command": "autotools.checkAll",
                "icon": "$(checklist)",
                "title": "%autotools.checkAll.title%"
            },
            {
                "command": "autotools.outline.checkAll",
                "icon": "$(checklist)",
                "title": "%autotools.outline.checkAll.title%"
            },
            {
                "command": "autotools.livecheck",
                "icon": "$(broadcast)",
                "title": "%autotools.command.livecheck.title%"
            },
            {
                "command": "autotools.check",
                "icon": "$(checklist)",
                "title": "%autotools.command.check.title%"
            },
            {
                "command": "autotools.build",
                "icon": "$(combine)",
                "title": "%autotools.command.build.title%"
            },
            {
                "command": "autotools.editMakefileAm",
                "icon": "$(go-to-file)",
                "title": "%autotools.command.editMakefileAm.title%"
            },
            {
                "command": "autotools.openLog",
                "icon": "$(open-preview)",
                "title": "%autotools.command.openLog.title%"
            },
            {
                "command": "autotools.command.regen",
                "title": "%autotools.command.regen.title%"
            },
            {
                "command": "autotools.newConfiguration",
                "title": "%autotools.palette.newConfiguration.title%"
            },
            {
                "command": "autotools.editConfigureAc",
                "icon": "$(tools)",
                "title": "%autotools.command.editConfigureAc.title%"
            },
            {
                "command": "autotools.test",
                "icon": "$(testing-run-icon)",
                "title": "%autotools.command.test.title%"
            },
            {
                "command": "autotools.debug",
                "icon": "$(testing-debug-icon)",
                "title": "%autotools.command.debug.title%"
            },
            {
                "command": "autotools.setBuildConfiguration",
                "title": "%autotools.command.makefile.setBuildConfiguration.title%"
            },
            {
                "command": "autotools.configure",
                "icon": "$(refresh)",
                "title": "%autotools.command.configure.title%"
            },
            {
                "command": "autotools.visit.knowledgeBase",
                "icon": "$(comment)",
                "title": "%autotools.command.visit.knowledgeBase.title%"

            },
            {
                "command": "autotools.exportToIntelisense",
                "title": "%autotools.exportToIntelisense.title%"
            },
            {
                "command": "autotools.command.openKnowledgeBase",
                "title": "%autotools.command.openKnowledgeBase.title%"
            },
            {
                "command": "autotools.configure.help",
                "title": "%autotools.command.configure.help.title%"
            },
            {
                "command": "autotools.outline.setBuildConfiguration",
                "title": "%autotools.command.setBuildConfiguration.title%",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "autotools.outline.recheck",
                "title": "%autotools.command.outline.recheck.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "autotools.resetState",
                "title": "%autotools.command.makefile.resetState.title%"
            }
        ],
        "problemMatchers": [
            {
                "name": "configureAc",
                "source": "autotools",
                "owner": "autotools",
                "fileLocation":[
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            },
            {
              "name": "gcc",
              "source": "gcc",
              "owner": "autotools",
              "fileLocation": [
                "autoDetect"
               ],
              "pattern": {
                "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                "file": 1,
                "line": 2,
                "column": 3,
                "severity": 4,
                "message": 5
              }
            },
            {
               "name": "msvc",
               "source": "msvc",
               "owner": "autotools",
               "base": "$msCompile",
               "fileLocation": [
                 "autoDetect"
               ]
             }
          ],
        "configuration": {
            "type": "object",
            "title": "Autotools",
            "properties": {

                "autotools.test_environments": {
                    "type": "array",
                    "default": [],
                    "description": "%autotools.configuration.test_environments.description%",
                    "items" : {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "format": "/^[a-zA-Z0-9_-]+$/",
                            "description": "%autotools.configuration.test_environments.name.description%",
                            "examples": ["legacy", "modern", "future"]
                          },
                          "TESTS_ENVIRONMENT" : {
                            "type": "array",
                            "default": [],
                            "title": "%autotools.configuration.tests_environment.TESTS_ENVIRONMENT.sub.title%",
                            "items": {
                                "type": "object",
                                "default": {},
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "value": {
                                        "type": "string"
                                    }
                                }
                            }
                          },
                          "XFAIL_TESTS" : {
                            "type": "array",
                            "default": [],
                            "title": "%autotools.configuration.tests_environment.XFAIL_TESTS.sub.title%",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": ["name"],
                        "title": "%autotools.configuration.tests_environment.title%",
                        "default": {
                            "name": "modern",
                            "TESTS_ENVIRONMENT": [
                                { "name": "VAR1", "value": "modern-1" }, {"name": "VAR2", "value": "mod2"}
                            ]
                        }
                    }
                },

                "autotools.configurations": {
                    "type": "array",
                    "default": [],
                    "description": "%autotools.configuration.makefile.configurations.description%",
                    "items": {
                        "type": "object",
                        "required": ["name", "top_builddir"],
                        "title": "%autotools.configurations.title%",
                        "default": {
                            "name": "Debug",
                            "top_builddir": "build/Debug",
                            "configureArgs": [
                                "--enable-option-checking",
                                "CFLAGS=-ggdb3 -O0",
                                "CXXFLAGS=-ggdb3 -O0"
                            ]
                        },
                        "$comment": "--enable-option-checking is to avoid silent ignoring arg mistakes. See  https://www.gnu.org/software/autoconf/manual/autoconf-2.67/html_node/Option-Checking.html",
                        "examples": [
                            {
                                "name": "Defaults - in-tree",
                                "top_builddir": ""
                            },
                            {
                                "name": "Debug w/ Valgrind support",
                                "top_builddir": "build/Valgrind",
                                "configureArgs": [
                                    "--enable-option-checking",
                                    "--enable-valgrind"
                                ]
                            },
                            {
                                "name": "Lunar Config",
                                "top_builddir": "build/Lunar",
                                "configureArgs": [
                                    "--enable-option-checking",
                                    "--enable-option1",
                                    "--with-option2=something",
                                    "CFLAGS=-D_FORTIFY_SOURCE=2"
                                ]
                            },
                            {
                                "name": "Lunar Config - Debug",
                                "top_builddir": "build/Lunar-Debug",
                                "configureArgs": [
                                    "--enable-option-checking",
                                    "--enable-option1",
                                    "--with-option2=something",
                                    "CFLAGS=-ggdb3 -O0 -Wall -Werror -pg -fprofile-arcs --coverage -ftest-coverage -fstack-protector-strong"
                                ]
                            },
                            {
                                "name": "Alpine Config",
                                "top_builddir": "build/Alpine",
                                "configureArgs": [
                                    "--enable-option-checking",
                                    "--disable-option1",
                                    "CFLAGS=-flto -g -O2 -fPIC -fstack-protector-strong"
                                ]
                            }
                        ],
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "%autotools.configuration.makefile.configurations.name.description%"
                            },
                            "top_builddir": {
                              "type": "string",
                              "title": "%autotools.configurations.top_builddir.title%",
                              "markdownDescription": "%autotools.configurations.top_builddir.markdownDescription%"
                            },
                            "configureArgs": {
                                "type": "array",
                                "markdownDescription": "%autotools.configurations.configureArgs.markdownDescription%",
                                "title": "%autotools.configurations.configureArgs.title%",
                                "examples": [
                                    ["--prefix=$HOME/bin"],
                                    ["--enable-debug"],
                                    ["--with-package=something"],
                                    ["CXX=g++-13"],
                                    ["CC=gcc-13"],
                                    ["RANLIB=gcc-ranlib-13"]
                                ]
                            },
                            "makeArgs": {
                                "type": "array",
                                "markdownDescription": "%autotools.configurations.makeArgs.markdownDescription%",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "problemMatchers": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": ["$gcc", "$msvc"],
                                "description": "%autotools.configuration.makefile.configurations.problemMatchers.description%"
                            }
                        }
                    },
                    "scope": "resource"
                },

                "autotools.TESTS_ENVIRONMENT" : {
                    "type": "array",
                    "default": [],
                    "title": "%autotools.configuration.tests_environment.TESTS_ENVIRONMENT.global.title%",
                    "items": {
                        "type": "object",
                        "default": {},
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "value": {
                                "type": "string"
                            }
                        }
                    }
                },
                "autotools.XFAIL_TESTS" : {
                    "type": "array",
                    "default": [],
                    "title": "%autotools.configuration.tests_environment.XFAIL_TESTS.sub.title%",
                    "items": {
                      "type": "string"
                    }
                },

                "autotools.loggingLevel": {
                    "type": "string",
                    "enum": [
                        "Normal",
                        "Verbose",
                        "Debug"
                    ],
                    "default": "Normal",
                    "description": "%autotools.configuration.makefile.loggingLevel.description%",
                    "scope": "resource"
                },
                "autotools.makePath": {
                    "type": "string",
                    "default": "make",
                    "description": "%autotools.configuration.makefile.makePath.description%",
                    "scope": "resource"
                },
                "autotools.autoBootstrap": {
                    "type": "boolean",
                    "markdownDescription": "%autotools.configuration.autoBootstrap.markdownDescription%",
                    "default": true,
                    "scope": "resource"
                },
                "autotools.keepDryRuns": {
                    "type": "boolean",
                    "markdownDescription": "%autotools.configuration.makefile.keepDryRuns.markdownDescription%",
                    "default": false,
                    "scope": "resource"
                },
                "autotools.keepConfigurationCache": {
                    "type": "boolean",
                    "markdownDescription": "%autotools.configuration.makefile.keepConfigurationCache.markdownDescription%",
                    "default": false,
                    "scope": "resource"
                },
                "autotools.promptClean": {
                    "type": "boolean",
                    "markdownDescription": "%autotools.configuration.promptClean.description%",
                    "default": true,
                    "scope": "resource"
                }
            }
        },
        "viewsWelcome": [
            {
                "view": "autotools.outline",
                "contents": "%autotools.welcome.markdownDescription%",
                "when": "autotools:haveManifest && !autotools:haveConfigurations"
            },
            {
                "view": "autotools.outline",
                "contents": "%autotools.welcome.convert.markdownDescription%",
                "when": "!autotools:haveManifest"
            },
            {
                "view": "debug",
                "contents": "%autotools.welcome.debug.auto.markdownDescription%",
                "when": "autotools:haveConfigurations"
            },
            {
                "view": "debug",
                "contents": "%autotools.welcome.debug.markdownDescription%",
                "when": "autotools:haveManifest && !autotools:haveConfigurations"
            }
        ],
        "languages": [
            {
            "filenames": ["Makefile.am", "Makefile.in"],
            "aliases": ["am"],
            "icon": {
                "light": "tools",
                "dark": "tools"
            },
            "id": "automake"
        },
        {
            "filenames": ["configure.ac", "configure.in"],
            "aliases": ["ac"],
            "icon": {
                "light": "tools",
                "dark": "tools"
            },
            "id": "autoconf"
        }
        ],
        "debuggers": [
            {
                "type": "autotools",
                "label": "Autotools Debug",
                "languages": ["c", "cpp", "am", "ac", "*"],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "default": "${file}",
                                "description": "%autotools.debugger.launch.program.description%"
                            },
                            "args": {
                                "type": "array",
                                "default": [],
                                "description": "%autotools.debugger.launch.args.description%"
                            },
                            "cwd": {
                                "type": "string",
                                "default": "${workspaceFolder}",
                                "description": "%autotools.debugger.launch.cwd.description%"
                            },
                            "environment": {
                                "type": "array",
                                "description": "%autotools.debugger.launch.env.description%",
                                "default": []
                            },
                            "stopAtEntry": {
                                "type": "boolean",
                                "default": false,
                                "description": "%autotools.debugger.launch.stopAtEntry.description%"
                            }
                        }
                    }
                },
                "configurationSnippets": [
                    {
                        "label": "Autotools: Launch the default build target",
                        "descriptionMarkdown": "Uses ${command:autotools.default_program} to automatically detect the target. Useful for debugging multiple programs with the same args and env. `autotools:default_program_build_task` is the default build task if set and is a linked binary program, otherwise the first program detected by importing the Makefiles",
                        "body": {
                            "type": "cppdbg",
                            "request": "launch",
                            "name": "${1:Launch the default build target}",
                            "program": "^\"\\${command:autotools.default_program}\"",
                            "preLaunchTask": "^\"\\${command:autotools.default_program_build_task}\"",
                            "cwd": "^\"\\${workspaceFolder}\"",
                            "environment": [],
                            "args": [],
                            "stopAtEntry": false
                        }
                    },
                    {
                        "label": "Autotools: Launch a program",
                        "description": "Hardcoded program path. Useful for debugging programs with different args or env",
                        "body": {
                            "type": "cppdbg",
                            "request": "launch",
                            "name": "${1:Launch myapp}",
                            "program": "src/myapp",
                            "preLaunchTask": "autotools: build 'myapp' in src",
                            "cwd": "^\"\\${workspaceFolder}\"",
                            "environment": [],
                            "args": [],
                            "stopAtEntry": false
                        }
                    }
                ]
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "autotools__viewContainer",
                    "title": "Autotools",
                    "when": "autotools:fullFeatureSet",
                    "icon": "res/viewcontainer.svg"
                }
            ]
        },
        "views": {
            "autotools__viewContainer": [
                {
                    "id": "autotools.outline",
                    "icon": "res/viewcontainer.svg",

                    "name": "%autotools.configuration.views.makefile.outline.description%"
                },
                {
                    "id": "autotools.tests",
                    "icon": "res/viewcontainer.svg",

                    "name": "%autotools.configuration.views.testsuites.description%"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "build",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label", "target"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "examples": ["Build myprogram", "Build mylib", "Build Tarball", "Build docs"]
                    },
                    "target": {
                        "description": "%autotools.taskDefinitions.target.description%",
                        "properties": {
                            "builddir": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.target.builddir.description%",
                                "examples": ["src", "src/lib", "lib"]
                            },
                            "goal": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.target.goal.description%",
                                "default": "all",
                                "examples": ["all", "myprogram.exe", "library.a"]
                            }
                        }
                    }
                }
            },
            {
                "type": "test",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label", "test"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "default": "Run test example"
                    },
                    "test": {
                        "description": "%autotools.taskDefinitions.test.description%",
                        "properties": {
                            "builddir": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.test.builddir.description%",
                                "examples": ["test/unit-tests", "test/integration-tests"]
                            },
                            "goal": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.test.goal.description%",
                                "examples": ["unit-tests.log", "integration-tests.log"]
                            }
                        }
                    }
                }
            },
            {
                "type": "check",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "default": "Run test-suite 'check'"
                    },
                    "check": {
                        "description": "%autotools.taskDefinitions.check.description%",
                        "properties": {
                            "builddir": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.check.builddir.description%",
                                "examples": ["test/unit-tests", "test/integration-tests"]
                            },
                            "TESTS": {
                                "type": "array",
                                "description": "%autotools.taskDefinitions.check.tests.markdownDescription%"
                            },
                            "TEST_SUITE_LOG": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.check.log.markdownDescription%"
                            }
                        }
                    }
                }
            },
            {
                "type": "autotools",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "default": "Bootstrap autotools"
                    },
                    "action": {
                        "type": "string",
                        "enum": ["bootstrap", "update"],
                        "default": "update",
                        "description": "%autotools.taskDefinitions.action.description%"
                    }
                }
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "autotools.addAutotools",
                    "when": "!autotools:isAutotoolsProject"
                },
                {
                    "command": "autotools.check",
                    "when": "never"
                },
                {
                    "command": "autotools.build",
                    "when": "never"
                },
                {
                    "command": "autotools.exportToIntelisense",
                    "when": "autotools:fullFeatureSet"
                },
                {
                    "command": "autotools.command.bootstrap",
                    "when": "!autotools.isBootstrapped"
                },
                {
                    "command": "autotools.configure",
                    "when": "autotools.isBootstrapped"
                },
                {
                    "command": "autotools.command.regen",
                    "when": "autotools:fullFeatureSet"
                },
                {
                    "command": "autotools.newConfiguration",
                    "when": "autotools:haveManifest"
                },
                {
                    "command": "autotools.setBuildConfiguration",
                    "when": "autotools:haveConfigurations"
                },
                {
                    "command": "autotools.test",
                    "when": "never"
                },
                {
                    "command": "autotools.debug",
                    "when": "never"
                },
                {
                    "command": "autotools.editMakefileAm",
                    "when": "never"
                },
                {
                    "command": "autotools.editConfigureAc",
                    "when": "never"
                },
                {
                    "command": "autotools.buildAll",
                    "when": "autotools:fullFeatureSet"
                },
                {
                    "command": "autotools.checkAll",
                    "when": "autotools:fullFeatureSet"
                },
                {
                    "command": "autotools.outline.recheck",
                    "when": "never"
                },
                {
                    "command": "autotools.configure.help",
                    "when": "autotools:haveManifest"
                },
                {
                    "command": "autotools.outline.setBuildConfiguration",
                    "when": "never"
                }
            ],
            "view/title": [
                {
                    "command": "autotools.outline.recheck",
                    "when": "view == autotools.outline",
                    "group": "1_makefileOutline@3"
                },
                {
                    "command": "autotools.outline.buildAll",
                    "when": "view == autotools.outline",
                    "group": "1_makefileOutline@3"
                },
                {
                    "command": "autotools.newConfiguration",
                    "when": "view == autotools.outline",
                    "group": "1_makefileOutline@3"
                },
                {
                    "command": "autotools.outline.checkAll",
                    "when": "view == autotools.tests",
                    "group": "1_makefileOutline@3"
                },
                {
                    "command": "autotools.visit.knowledgeBase",
                    "when": "view == autotools.outline",
                    "group": "navigation@1"
                },
                {
                    "command": "autotools.outline.recheck",
                    "when": "view == autotools.outline",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "autotools.build",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=build/",
                    "group": "inline@10"
                },
                {
                    "command": "autotools.buildAll",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=allbuild/",
                    "group": "inline@10"
                },
                {
                    "command": "autotools.test",
                    "when": "view == autotools.tests && viewItem =~ /nodeType=test/",
                    "group": "inline@10"
                },
                {
                    "command": "autotools.livecheck",
                    "when": "view == autotools.tests && viewItem =~ /nodeType=check/",
                    "group": "inline@9"
                },
                {
                    "command": "autotools.debug",
                    "when": "view == autotools.tests && viewItem =~ /nodeType=bintest/",
                    "group": "inline@9"
                },
                {
                    "command": "autotools.check",
                    "when": "view == autotools.tests && viewItem =~ /nodeType=check/",
                    "group": "inline@11"
                },
                {
                    "command": "autotools.checkAll",
                    "when": "view == autotools.tests && viewItem =~ /nodeType=allcheck/",
                    "group": "inline@11"
                },
                {
                    "command": "autotools.editMakefileAm",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=sub/",
                    "group": "inline@1"
                },
                {
                    "command": "autotools.openLog",
                    "when": "view == autotools.tests && viewItem =~ /nodeType=check/",
                    "group": "inline@2"
                },
                {
                    "command": "autotools.editConfigureAc",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=configuration/",
                    "group": "inline@5"
                },
                {
                    "command": "autotools.outline.recheck",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=configuration/",
                    "group": "1_stateActions@1"
                },
                {
                    "command": "autotools.outline.setBuildConfiguration",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=configuration/",
                    "group": "inline@10"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "yarn compile-production && npm run esbuild-base -- --minify",
        "bootstrap": "cd vendor/gnumake && [ -f configure ] || autoreconf -fvi",
        "preconfigure": "yarn run bootstrap",
        "configure": "mkdir -p build/make && cd build/make && [ -f config.status ] || ../../vendor/gnumake/configure --disable-dependency-tracking --with-guile=no --disable-job-server --disable-load 'INSTALL_PROGRAM=install -cs' 'CFLAGS=-g0 -O2' --disable-nls --prefix=$PWD/../..",
        "preproduction-compile": "yarn run configure",
        "production-compile": "make -j -C build/make all install-binPROGRAMS && cp vendor/automake/lib/test-driver bin && yarn install && tsc -p ./",
        "compile": "yarn install && tsc -p ./",
        "precompile-production": "yarn run production-compile",
        "compile-production": "yarn install && yarn run translations-generate",
        "translations-export": "gulp translations-export",
        "translations-generate": "gulp translations-generate",
        "translations-import": "gulp translations-import",

        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "test-compile": "tsc -p ./",

        "watch": "tsc -watch -p ./",
        "package": "echo Do something like vsce package --pre-release --target linux-x64 --yarn -o autotools.vsix",
        "publish": "vsce publish --pre-release --yarn -i autotools.vsix",
        "pretest": "yarn compile",
        "test": "yarn run pretest && node ./out/src/test/runTest.js"
    },
