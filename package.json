{
    "name": "autotools",
    "displayName": "Autotools Integration",
    "description": "Import autotools configuration into C/C++ IntelliSense",
    "version": "0.1.0",
    "publisher": "mergesium",
    "preview": true,
    "icon": "res/autotools.png",
    "readme": "README.md",
    "author": {
        "name": "Mergesium Inc."
    },
    "license": "SEE LICENSE IN LICENSE.txt",
    "engines": {
        "vscode": "^1.74.0"
    },
    "bugs": {
        "url": "https://github.com/Mergesium/vscode-makefile-tools/issues",
        "email": "support.vscode.autotools@mergesium.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mergesium/vscode-makefile-tools.git"
    },
    "homepage": "https://github.com/Mergesium/vscode-makefile-tools",
    "qna": "https://github.com/Mergesium/vscode-makefile-tools/issues",
    "keywords": [
        "C",
        "C++",
        "IntelliSense",
        "Mergesium",
        "Makefile"
    ],
    "categories": [
        "Programming Languages",
        "Debuggers",
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "autotools.command.bootstrap",
                "title": "%autotools.command.bootstrap.title%"
            },
            {
                "command": "autotools.buildAll",
                "title": "%autotools.command.makefile.buildAll.title%"
            },
            {
                "command": "autotools.setBuildConfiguration",
                "title": "%autotools.command.makefile.setBuildConfiguration.title%"
            },
            {
                "command": "autotools.setBuildTarget",
                "title": "%autotools.command.makefile.setBuildTarget.title%"
            },
            {
                "command": "autotools.configure",
                "title": "%autotools.command.makefile.configure.title%"
            },
            {
                "command": "autotools.cleanConfigure",
                "title": "%autotools.command.makefile.cleanConfigure.title%"
            },
            {
                "command": "autotools.outline.setBuildConfiguration",
                "title": "%autotools.command.makefile.setBuildConfiguration.title%",
                "icon": "$(notebook-edit)"
            },
            {
                "command": "autotools.outline.setBuildTarget",
                "title": "%autotools.command.makefile.setBuildTarget.title%",
                "icon": "$(notebook-edit)"
            },
            {
                "command": "autotools.outline.configure",
                "title": "%autotools.command.makefile.configure.title%",
                "icon": "$(settings)"
            },
            {
                "command": "autotools.outline.cleanConfigure",
                "title": "%autotools.command.makefile.cleanConfigure.title%"
            },
            {
                "command": "autotools.resetState",
                "title": "%autotools.command.makefile.resetState.title%"
            }
        ],
        "problemMatchers": [
            {
              "name": "gcc",
              "source": "gcc",
              "owner": "autotools",
              "fileLocation": [
                "autoDetect",
                "${command:autotools.makeBaseDirectory}"
               ],
              "pattern": {
                "regexp": "^(.*?):(\\d+):(\\d*):?\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                "file": 1,
                "line": 2,
                "column": 3,
                "severity": 4,
                "message": 5
              }
            },
            {
               "name": "msvc",
               "source": "msvc",
               "owner": "autotools",
               "base": "$msCompile",
               "fileLocation": [
                 "autoDetect",
                 "${command:autotools.makeBaseDirectory}"
               ]
             }
          ],
        "configuration": {
            "type": "object",
            "title": "Autotools",
            "properties": {
                "autotools.configurations": {
                    "type": "array",
                    "default": [],
                    "description": "%autotools.configuration.makefile.configurations.description%",
                    "items": {
                        "type": "object",
                        "default": null,
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "%autotools.configuration.makefile.configurations.name.description%"
                            },
                            "makeDirectory": {
                              "type": "string",
                              "description": "%autotools.configuration.makefile.configurations.makeDirectory.description%"
                            },
                            "makeArgs": {
                                "type": "array",
                                "description": "%autotools.configuration.makefile.configurations.makeArgs.description%",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "problemMatchers": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": ["$gcc", "$msvc"],
                                "description": "%autotools.configuration.makefile.configurations.problemMatchers.description%"
                            }
                        }
                    },
                    "scope": "resource"
                },
                "autotools.loggingLevel": {
                    "type": "string",
                    "enum": [
                        "Normal",
                        "Verbose",
                        "Debug"
                    ],
                    "default": "Normal",
                    "description": "%autotools.configuration.makefile.loggingLevel.description%",
                    "scope": "resource"
                },
                "autotools.makePath": {
                    "type": "string",
                    "default": "make",
                    "description": "%autotools.configuration.makefile.makePath.description%",
                    "scope": "resource"
                },
                "autotools.makeDirectory": {
                    "type": "string",
                    "description": "%autotools.configuration.makefile.makeDirectory.description%",
                    "scope": "resource"
                },
                "autotools.extensionLog": {
                    "type": "string",
                    "description": "%autotools.configuration.makefile.extensionLog.description%",
                    "default": "",
                    "scope": "resource"
                },
                "autotools.autoBootstrap": {
                    "type": "boolean",
                    "markdownDescription": "%autotools.configuration.autoBootstrap.markdownDescription%",
                    "default": true,
                    "scope": "resource"
                },
                "autotools.keepDryRuns": {
                    "type": "boolean",
                    "markdownDescription": "%autotools.configuration.makefile.keepDryRuns.markdownDescription%",
                    "default": false,
                    "scope": "resource"
                },
                "autotools.keepConfigurationCache": {
                    "type": "boolean",
                    "markdownDescription": "%autotools.configuration.makefile.keepConfigurationCache.markdownDescription%",
                    "default": false,
                    "scope": "resource"
                },
                "autotools.additionalCompilerNames": {
                    "type": "array",
                    "default": [],
                    "description": "%autotools.configuration.makefile.additionalCompilerNames.description%",
                    "items": {
                        "type": "string"
                    },
                    "scope": "resource"
                },
                "autotools.excludeCompilerNames": {
                    "type": "array",
                    "default": [],
                    "description": "%autotools.configuration.makefile.excludeCompilerNames.description%",
                    "items": {
                        "type": "string"
                    },
                    "scope": "resource"
                },
                "autotools.configureOnOpen": {
                    "type": "boolean",
                    "default": true,
                    "description": "%autotools.configuration.makefile.configureOnOpen.description%",
                    "scope": "resource"
                },
                "autotools.configureOnEdit": {
                    "type": "boolean",
                    "default": true,
                    "description": "%autotools.configuration.makefile.configureOnEdit.description%",
                    "scope": "resource"
                },
                "autotools.configureAfterCommand": {
                    "type": "boolean",
                    "default": true,
                    "description": "%autotools.configuration.makefile.configureAfterCommand.description%",
                    "scope": "resource"
                },
                "autotools.ignoreDirectoryCommands": {
                    "type": "boolean",
                    "description": "%autotools.configuration.makefile.ignoreDirectoryCommands.description%",
                    "default": true,
                    "scope": "resource"
                },
                "autotools.saveBeforeBuildOrConfigure": {
                    "type": "boolean",
                    "default": true,
                    "description": "%autotools.configuration.makefile.saveBeforeBuildOrConfigure.description%",
                    "scope": "resource"
                },
                },
                "autotools.panel.visibility": {
                    "type": "object",
                    "default": null,
                    "properties": {
                        "debug": {
                            "type": "boolean",
                            "description": "%autotools.configuration.makefile.panel.visibility.debug.description%",
                            "default": true
                        },
                        "run": {
                            "type": "boolean",
                            "description": "%autotools.configuration.makefile.panel.visibility.run.description%",
                            "default": true
                        }
                    }
                }
            }
        },
        "debuggers": [
            {
                "type": "cppdbg",
                "label": "Autotools Debug",
                "languages": ["c", "cpp"],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "default": "${file}",
                                "description": "%autotools.debugger.launch.program.description%"
                            },
                            "args": {
                                "type": "array",
                                "default": [],
                                "description": "%autotools.debugger.launch.args.description%"
                            },
                            "cwd": {
                                "type": "string",
                                "default": "${workspaceFolder}",
                                "description": "%autotools.debugger.launch.cwd.description%"
                            },
                            "environment": {
                                "type": "array",
                                "description": "%autotools.debugger.launch.env.description%",
                                "default": []
                            },
                            "stopAtEntry": {
                                "type": "boolean",
                                "default": false,
                                "description": "%autotools.debugger.launch.stopAtEntry.description%"
                            }
                        }
                    }
                },
                "configurationSnippets": [
                    {
                        "label": "Autotools: Launch current build target under gdb",
                        "description": "Debug current build target with cppdbg. Uses variables",
                        "body": {
                            "type": "cppdbg",
                            "request": "launch",
                            "name": "${1:Launch current autotools build target}",
                            "program": "^\"\\${command:autotools.builddir}/\\${command:autotools.goal}\"",
                            "cwd": "^\"\\${workspaceFolder}\"",
                            "environment": [],
                            "args": [],
                            "stopAtEntry": false
                        }
                    }
                ]
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "autotools__viewContainer",
                    "title": "Autotools",
                    "when": "autotools:fullFeatureSet",
                    "icon": "res/viewcontainer.svg"
                }
            ]
        },
        "views": {
            "autotools__viewContainer": [
                {
                    "id": "autotools.outline",
                    "name": "%autotools.configuration.views.makefile.outline.description%"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "build",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label", "target"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "examples": ["Build myprogram", "Build mylib", "Build Tarball", "Build docs"]
                    },
                    "target": {
                        "description": "%autotools.taskDefinitions.target.description%",
                        "properties": {
                            "builddir": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.target.builddir.description%",
                                "examples": ["src", "src/lib", "lib"]
                            },
                            "goal": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.target.goal.description%",
                                "default": "all",
                                "examples": ["all", "myprogram.exe", "library.a"]
                            }
                        }
                    }
                }
            },
            {
                "type": "test",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label", "test"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "default": "Run test example"
                    },
                    "test": {
                        "description": "%autotools.taskDefinitions.test.description%",
                        "properties": {
                            "builddir": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.test.builddir.description%",
                                "examples": ["test/unit-tests", "test/integration-tests"]
                            },
                            "goal": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.test.goal.description%",
                                "examples": ["unit-tests.log", "integration-tests.log"]
                            }
                        }
                    }
                }
            },
            {
                "type": "check",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "default": "Run test-suite 'check'"
                    },
                    "check": {
                        "description": "%autotools.taskDefinitions.check.description%",
                        "properties": {
                            "builddir": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.check.builddir.description%",
                                "examples": ["test/unit-tests", "test/integration-tests"]
                            },
                            "TESTS": {
                                "type": "array",
                                "description": "%autotools.taskDefinitions.check.tests.markdownDescription%"
                            },
                            "TEST_SUITE_LOG": {
                                "type": "string",
                                "description": "%autotools.taskDefinitions.check.log.markdownDescription%"
                            }
                        }
                    }
                }
            },
            {
                "type": "bootstrap",
                "when": "processExecutionSupported && autotools.makefileFilePresent",
                "required": ["label"],
                "properties": {
                    "label": {
                        "type": "string",
                        "description": "%autotools.taskDefinitions.label.description%",
                        "default": "Bootstrap autotools"
                    }
                }
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "autotools.command.bootstrap"
                },
                {
                    "command": "autotools.buildAll",
                    "when": "autotools:fullFeatureSet"
                },
                {
                    "command": "autotools.setBuildTarget",
                    "when": "autotools:fullFeatureSet"
                },
                {
                    "command": "autotools.outline.configure",
                    "when": "never"
                },
                {
                    "command": "autotools.outline.cleanConfigure",
                    "when": "never"
                },
                {
                    "command": "autotools.outline.setBuildConfiguration",
                    "when": "never"
                },
                {
                    "command": "autotools.outline.setBuildTarget",
                    "when": "never"
                }
            ],
            "view/title": [
                {
                    "command": "autotools.outline.configure",
                    "when": "view == autotools.outline",
                    "group": "1_makefileOutline@3"
                },
                {
                    "command": "autotools.outline.cleanConfigure",
                    "when": "view == autotools.outline",
                    "group": "1_makefileOutline@4"
                }
            ],
            "view/item/context": [
                {
                    "command": "autotools.outline.configure",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=configuration/",
                    "group": "1_stateActions@1"
                },
                {
                    "command": "autotools.outline.cleanConfigure",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=configuration/",
                    "group": "1_stateActions@2"
                },
                {
                    "command": "autotools.outline.setBuildConfiguration",
                    "when": "view == autotools.outline && viewItem =~ /nodeType=configuration/",
                    "group": "inline@1"
                },
                {
                    "command": "autotools.outline.setBuildTarget",
                    "when": "autotools:fullFeatureSet && view == autotools.outline && viewItem =~ /nodeType=buildTarget/",
                    "group": "inline@1"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "yarn compile-production",
        "compile": "yarn install && tsc -p ./",
        "compile-production": "yarn install && yarn run translations-generate",
        "translations-export": "gulp translations-export",
        "translations-generate": "gulp translations-generate",
        "translations-import": "gulp translations-import",
        "watch": "tsc -watch -p ./",
        "package": "vsce package --pre-release --yarn -o autotools.vsix",
        "publish": "vsce publish --pre-release --yarn -i autotools.vsix",
        "pretest": "yarn compile",
        "test": "yarn run pretest && node ./out/src/test/runTest.js"
    },
    "devDependencies": {
        "@octokit/rest": "^18.1.1",
        "@types/chai": "^4.2.15",
        "@types/chai-as-promised": "^7.1.3",
        "@types/chai-string": "^1.4.2",
        "@types/mocha": "^9.0.0",
        "@types/node": "^10.17.17",
        "@types/vscode": "^1.74.0",
        "@vscode/vsce": "^2.21.1",
        "chai": "^4.3.0",
        "chai-as-promised": "^7.1.1",
        "chai-string": "^1.5.0",
        "gulp": "^4.0.2",
        "gulp-eslint": "^6.0.0",
        "gulp-filter": "^6.0.0",
        "gulp-mocha": "^8.0.0",
        "gulp-sourcemaps": "^3.0.0",
        "gulp-typescript": "^5.0.1",
        "jsonc-parser": "^3.0.0",
        "parse-git-config": "^3.0.0",
        "tslint": "^5.20.1",
        "tslint-microsoft-contrib": "^6.2.0",
        "tslint-no-unused-expression-chai": "^0.1.4",
        "typescript": "^5.0.2",
        "vrsource-tslint-rules": "^6.0.0",
        "vscode-nls-dev": "^3.3.2",
        "vscode-test": "^0.4.1"
    },
    "dependencies": {
        "@mergesium/shell-quote": "^2.0.1",
        "@types/glob": "^7.1.1",
        "@vscode/extension-telemetry": "^0.6.2",
        "glob": "^7.1.6",
        "module-alias": "^2.2.2",
        "vscode-cpptools": "^6.1.0",
        "vscode-jsonrpc": "^3.6.2",
        "vscode-nls": "^5.0.0"
    },
    "resolutions": {
        "ansi-regex": "^5.0.1",
        "glob-parent": "^5.1.2",
        "markdown-it": "^12.3.2",
        "minimist": "^1.2.6",
        "nanoid": "^3.1.20",
        "minimatch": "^3.0.5",
        "xml2js": "^0.5.0"
    }
}
